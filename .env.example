# ── 서버(Netlify Function)에서만 쓰는 키 — 클라이언트 번들에 노출 안 됨 ──
# Netlify 대시보드의 Environment variables에 등록하세요.
ANTHROPIC_API_KEY=      # AI 일기 / 무드 트래커
TMDB_API_KEY=           # 영화·드라마 검색
ALADIN_API_KEY=         # 도서 검색 (알라딘 TTBKey)
NOTION_TOKEN=           # 노션 동기화

# ── 클라이언트에서 쓰는 값 (VITE_ 접두사 = 번들에 포함됨, 민감정보 금지) ──
VITE_SYNC_PASSWORD=     # 노션 동기화 버튼 비밀번호 (비워두면 동기화 비활성)
# DB ID 자동 생성 시 부모 페이지 (Notion에 'CherryPlan' 페이지가 없을 때만 필요)
VITE_NOTION_PARENT_PAGE_ID=
# 이미 만든 DB가 있다면 직접 지정 (없으면 자동 생성)
VITE_NOTION_MOVIE_DB_ID=
VITE_NOTION_MOOD_DB_ID=
